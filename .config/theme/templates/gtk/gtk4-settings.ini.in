# Generated by ~/.config/theme/theme-apply from templates/gtk/gtk4-settings.ini.in.
# Don't edit: it's overwritten on every theme change. Mode: @mode@
# No gtk-theme-name: GTK4 only has Adwaita, and libadwaita follows the
# colour scheme (GSettings, set by theme-apply) instead.
[Settings]
gtk-icon-theme-name=@icon_theme@
gtk-application-prefer-dark-theme=@prefer_dark@
