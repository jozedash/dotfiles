# Generated by ~/.config/theme/theme-apply from templates/gtk/gtk3-settings.ini.in.
# Don't edit: it's overwritten on every theme change. Mode: @mode@
# On Wayland GSettings wins over this file; theme-apply sets both.
[Settings]
gtk-theme-name=@gtk_theme@
gtk-icon-theme-name=@icon_theme@
gtk-application-prefer-dark-theme=@prefer_dark@
