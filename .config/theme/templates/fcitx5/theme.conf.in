# Generated by ~/.config/theme/theme-apply from templates/fcitx5/theme.conf.in.
# Don't edit: it's overwritten on every theme change. Mode: @mode@
[Metadata]
Name=Hypr
Version=1
Author=joe
Description=Matches the waybar style: translucent panel, accent border, rounded corners. Based on default-dark.
# Hyprland runs at scale 1, so don't enlarge the popup on high-DPI monitors
ScaleWithDPI=False

[InputPanel]
NormalColor=@fg@
HighlightCandidateColor=@on_secondary@
HighlightColor=@on_secondary@
HighlightBackgroundColor=@secondary@
PageButtonAlignment=Last Candidate

[InputPanel/TextMargin]
Left=5
Right=5
Top=5
Bottom=5

# Keeps text clear of the rounded corners in panel.png
[InputPanel/ContentMargin]
Left=8
Right=8
Top=8
Bottom=8

# fcitx5 only draws square corners, so the background is a 9-slice image:
# Margin is how much of each edge of panel.png is kept unstretched
[InputPanel/Background]
Image=panel.png

[InputPanel/Background/Margin]
Left=16
Right=16
Top=16
Bottom=16

[InputPanel/Highlight]
Image=highlight.png

[InputPanel/Highlight/Margin]
Left=10
Right=10
Top=10
Bottom=10

[InputPanel/PrevPage]
Image=prev.svg

[InputPanel/PrevPage/ClickMargin]
Left=5
Right=5
Top=4
Bottom=4

[InputPanel/NextPage]
Image=next.svg

[InputPanel/NextPage/ClickMargin]
Left=5
Right=5
Top=4
Bottom=4

[Menu]
NormalColor=@fg@
HighlightCandidateColor=@on_secondary@

[Menu/Background]
Image=panel.png

[Menu/Background/Margin]
Left=16
Right=16
Top=16
Bottom=16

[Menu/ContentMargin]
Left=8
Right=8
Top=8
Bottom=8

[Menu/CheckBox]
Image=radio.svg

[Menu/SubMenu]
Image=arrow.svg

[Menu/Highlight]
Image=highlight.png

[Menu/Highlight/Margin]
Left=10
Right=10
Top=10
Bottom=10

[Menu/Separator]
Color=@primary@

[Menu/TextMargin]
Left=5
Right=5
Top=5
Bottom=5
