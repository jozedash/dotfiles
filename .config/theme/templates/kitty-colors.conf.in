# Generated by ~/.config/theme/theme-apply from templates/kitty-colors.conf.in.
# Don't edit: it's overwritten on every theme change. Mode: @mode@

# Content background, like Thunar's file view; text in the mode's colour
background @base@
foreground @fg@

# Accents from the pair
cursor @primary@
cursor_text_color @base@
url_color @primary_text@
selection_background @secondary@
selection_foreground @on_secondary@
active_border_color @primary@
inactive_border_color @muted@
bell_border_color @critical@
active_tab_background @secondary@
active_tab_foreground @on_secondary@
inactive_tab_background @bg_opaque@
inactive_tab_foreground @fg@
tab_bar_background @bg_opaque@

# Terminal colours (fixed per mode, see ANSI in theme.py)
color0 @color0@
color1 @color1@
color2 @color2@
color3 @color3@
color4 @color4@
color5 @color5@
color6 @color6@
color7 @color7@
color8 @color8@
color9 @color9@
color10 @color10@
color11 @color11@
color12 @color12@
color13 @color13@
color14 @color14@
color15 @color15@
