/* Generated by ~/.config/theme/theme-apply from templates/css-vars.css.in.
 * Don't edit: it's overwritten on every theme change. Mode: @mode@
 * For GTK4 programs, which use CSS variables instead of @define-color. */
:root {
  --primary: @primary@;
  --primary-text: @primary_text@;
  --secondary: @secondary@;
  --on-secondary: @on_secondary@;
  --bg: @bg@;
  --bg-rgb: @bg_rgb@;
  --bg-alpha: @bg_alpha@;
  --bg-opaque: @bg_opaque@;
  --base: @base@;
  --fg: @fg@;
  --fg-disabled: @fg_disabled@;
  --muted: @muted@;
  --hover: @hover@;
  --darker: @darker@;
  --focus: @focus@;
  --close-bg: @close_bg@;
  --close-bg-hover: @close_bg_hover@;
  --critical: @critical@;
}
