// Generated by ~/.config/theme/theme-apply from templates/fastfetch.jsonc.in.
// Don't edit: it's overwritten on every theme change. Mode: @mode@
// fastfetch has no includes, so this is the whole config: the default modules
// (from fastfetch --gen-config) with colours from the theme. Change the
// modules in the template.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "color": { "1": "@primary_text@", "2": "@secondary_text@" }
  },
  "display": {
    "color": { "keys": "@primary_text@", "title": "@secondary_text@" }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}
