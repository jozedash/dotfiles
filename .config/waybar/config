{
  "layer": "top", "position": "top",
  // Machine-specific settings (backlight device, temperature sensor), see hosts/ in the dotfiles repo
  "include": ["~/.config/dotfiles-host/waybar.jsonc"],
  "modules-left": ["custom/logo", "clock",  "custom/weather", "disk", "memory", "cpu", "temperature", "custom/powerDraw", "hyprland/window" ],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": ["custom/updates", "tray", "custom/usb", "custom/notification", "custom/clipboard", "backlight", "idle_inhibitor", "custom/colorpicker", "custom/theme", "bluetooth", "pulseaudio", "network", "custom/battery" ],
  "reload_style_on_change":true,

  // Icons are SVGs drawn by style.css (see icons/), so formats only hold text.
  // A format of " " keeps an icon-only module visible.

  "custom/logo": {
    "format": " ",
    "tooltip": false
  },

  "hyprland/workspaces": {
    "format": " ",
    "persistent-workspaces": {
      "*": [ 1, 2, 3, 4, 5, 6 ]
    }
  },

  "idle_inhibitor": {
    "format": " ",
    "tooltip-format-activated": "Staying awake",
    "tooltip-format-deactivated": "Idle allowed"
  },

  "custom/weather": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/weather.sh",
    "interval": 900,
    "on-click": "firefox https://wttr.in"
  },

  "custom/clipboard": {
    "format": " ",
    "tooltip-format": "Clipboard history",
    "on-click": "cliphist list | wofi --dmenu | cliphist decode | wl-copy"
  },

  "clock": {
    "format": "{:%I:%M:%S %p}",
    "interval": 1,
    "tooltip-format": "\n<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "weeks-pos": "right",
      "format": {
        "today":    "<span color='#7645AD'><b><u>{}</u></b></span>",
        "days":     "<span color='#aeaeae'><b>{}</b></span>",
        "weeks":    "<span color='#aeaeae'><b>W{:%V}</b></span>",
        "weekdays": "<span color='#aeaeae'><b>{}</b></span>"
      }
    }
  },

  "bluetooth": {
    "format-on": " ",
    "format-off": " ",
    "format-disabled": " ",
    "format-connected": "{num_connections}",
    "format-connected-battery": "{device_battery_percentage}%",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    "on-click": "blueman-manager"
  },

  "network": {
    "format-wifi": "{signalStrength}%",
    "format-ethernet": " ",
    "format-linked": " ",
    "format-disconnected": " ",
    "tooltip-format": "{ipaddr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) | {ipaddr}",
    "tooltip-format-ethernet": "{ifname} | {ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "kitty -e impala"
  },

  // Replaces the built-in battery module so clicking can toggle Long Life mode
  "custom/battery": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/battery.sh",
    "interval": 10,
    "signal": 9,
    "on-click": "~/.config/waybar/scripts/battery.sh toggle"
  },

  "backlight": {
    "format": "{percent}%",
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-",
    "smooth-scrolling-threshold": 1
  },

  "disk": {
    "interval": 30,
    "format": "{percentage_used}%",
    "path": "/"
  },

  "custom/colorpicker": {
    "format": "{}",
    "return-type": "json",
    "interval": "once",
    "exec": "~/.config/waybar/scripts/colorpicker.sh -j",
    "on-click": "sleep 1 && ~/.config/waybar/scripts/colorpicker.sh",
    "signal": 1
  },

  // Theme switcher: palette popup, favourites, dark/light (see ~/.config/theme).
  // theme-apply sends signal 11 on every change, which re-runs exec.
  "custom/theme": {
    "format": "{}",
    "return-type": "json",
    "interval": "once",
    "signal": 11,
    "exec": "~/.config/waybar/scripts/theme.sh",
    "on-click": "~/.config/theme/theme-popup",
    "on-click-right": "~/.config/theme/theme-apply --cycle-favourite",
    "on-click-middle": "~/.config/theme/theme-apply --toggle-mode"
  },

  "cpu": {
    "interval": 1,
    "format": "{usage}%",
    "min-length": 4,
    "on-click": "kitty -e htop"
  },

  "memory": {
    "format": "{percentage}%",
    "on-click": "kitty -e htop"
  },

  "hyprland/window": {
    "format": "( {class} )"
  },

  "temperature": {
    "format": "{temperatureC}°C",
    "interval": 1,
    "critical-threshold": 85,
    "on-click": "kitty btop"
  },

  "pulseaudio": {
    "format": "{volume}%",
    "format-muted": "{volume}%",
    // Pulseaudio states match at or BELOW the value (like battery), despite
    // waybar-states(5) saying otherwise; the lowest matching state wins
    "states": {
      "low": 33,
      "medium": 66,
      "high": 150
    },
    "on-click": "pavucontrol",
    "tooltip-format": "{desc}: {volume}%"
  },

  "tray": {
    "icon-size": 14,
    "spacing": 10
  },

  "custom/notification": {
    "format": " ",
    "return-type": "json",
    "exec-if": "command -v swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  // Drives mounted by udiskie (hidden when there are none)
  "custom/usb": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/usb.sh",
    "interval": 10,
    "signal": 10,
    "on-click": "kitty -e yazi /run/media/$USER",
    "on-click-right": "udiskie-umount --all"
  },

  "custom/updates": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/updates.sh",
    "interval": 600,
    "signal": 8,
    "on-click": "kitty -e ~/.config/waybar/scripts/upgrade.sh"
  },

  "custom/powerDraw": {
    "format": "{}",
    "interval": 5,
    "exec": "~/.config/waybar/scripts/powerdraw.sh",
    "return-type": "json"
  }

}
